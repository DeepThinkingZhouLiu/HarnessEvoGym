{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "EvaluationPolicy",
  "metadata": {
    "id": "rsi-mvp-v1"
  },
  "spec": {
    "decisionPartition": "selection",
    "bootstrap": {
      "samples": 5000,
      "confidence": 0.95,
      "seed": 20260821
    },
    "gates": {
      "coverage": {
        "minimumRecords": 1,
        "minimumCompletion": 1
      },
      "quality": {
        "minimumNetResolved": 1,
        "minimumDeltaResolvedRate": 0,
        "maximumRegressions": 0,
        "requirePositivePairedCiLowerBound": false
      },
      "cost": {
        "maximumRelativeInferenceCostIncrease": 0.25,
        "maximumEvolutionCostUsd": 20
      },
      "safety": {
        "maximumPolicyViolations": 0
      }
    }
  }
}
