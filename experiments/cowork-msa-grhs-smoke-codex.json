{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "EvolutionExperiment",
  "metadata": { "id": "cowork-msa-grhs-smoke-codex" },
  "spec": {
    "adapters": {
      "target": "adapters/targets/msa-minimal-cowork-rsi.yml",
      "updater": "adapters/updaters/codex-cli.yml",
      "environment": "environments/omegause-officeval-agentbay.yml",
      "provider": "adapters/providers/zcloud-openai.yml"
    },
    "benchmark": "benchmarks/cowork-omegause-officeval-smoke/benchmark.json",
    "policy": "evaluation/policies/cowork-rsi-smoke.json",
    "models": {
      "solver": {
        "provider": "zcloud-openai",
        "model": "gpt-5.6-terra",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      },
      "updater": {
        "provider": "zcloud-openai",
        "model": "gpt-5.6-terra",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      }
    },
    "evolution": {
      "mutationLevel": "l2",
      "generations": 1,
      "trialsPerInstance": 1,
      "seeds": [20260902],
      "grhs": {
        "groupSize": 2,
        "minimumValidCandidates": 2,
        "regressionPenalty": 0.5,
        "costPenalty": 0.05,
        "complexityPenalty": 0.05,
        "advantageEpsilon": 1e-8,
        "priorLearningRate": 0.1,
        "promotionMargin": 0
      }
    }
  }
}
