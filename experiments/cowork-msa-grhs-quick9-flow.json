{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "EvolutionExperiment",
  "metadata": {
    "id": "cowork-msa-grhs-quick9-flow"
  },
  "spec": {
    "adapters": {
      "target": "adapters/targets/msa-minimal-cowork-rsi.yml",
      "updater": "adapters/updaters/codex-cli.yml",
      "environment": "environments/omegause-officeval-agentbay.yml",
      "provider": "adapters/providers/zcloud-openai.yml"
    },
    "benchmark": "benchmarks/cowork-omegause-officeval-linux-v1/benchmark-quick9-flow.json",
    "policy": "evaluation/policies/cowork-officeval-rsi.json",
    "models": {
      "solver": {
        "provider": "zcloud-openai",
        "model": "gpt-5.6-terra",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      },
      "updater": {
        "provider": "zcloud-openai",
        "model": "gpt-5.6-terra",
        "maxTokens": 8192,
        "reasoningEffort": "high"
      }
    },
    "evolution": {
      "mutationLevel": "l2",
      "generations": 1,
      "trialsPerInstance": 1,
      "seeds": [
        20260827
      ],
      "grhs": {
        "groupSize": 2,
        "minimumValidCandidates": 2,
        "advantageEpsilon": 1e-8,
        "priorLearningRate": 0.1
      }
    }
  }
}
